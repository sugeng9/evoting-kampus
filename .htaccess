<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to sensitive root files and directories
    RewriteRule ^(\.env|\.git|composer\.(json|lock)|package\.json|package-lock\.json|artisan|phpunit\.xml) - [F,L]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests)/(.*)?$ - [F,L]

    # Automatically redirect any root request to public/
    RewriteRule ^$ public/ [L]
    RewriteRule (.*) public/$1 [L]
</IfModule>

# Block Directory Listing
Options -Indexes
